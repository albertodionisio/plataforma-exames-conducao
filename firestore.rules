rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function verifiedEmail() {
      return request.auth.token.email_verified == true;
    }

    function validProfile(data, uid) {
      return data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'phone',
          'photoURL',
          'createdAt',
          'updatedAt'
        ])
        && data.uid == uid
        && (!('email' in data)
          || (request.auth.token.email != null
            && data.email == request.auth.token.email))
        && (!('displayName' in data)
          || (data.displayName is string && data.displayName.size() <= 100))
        && (!('phone' in data)
          || (data.phone is string && data.phone.size() <= 30))
        && (!('photoURL' in data)
          || (data.photoURL is string && data.photoURL.size() <= 2048))
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    match /users/{uid} {
      allow get: if ownsUser(uid);
      allow list: if false;
      allow create: if ownsUser(uid) && (verifiedEmail() || request.auth.token.phoneAuth == true) && validProfile(request.resource.data, uid);
      allow update: if ownsUser(uid) && (verifiedEmail() || request.auth.token.phoneAuth == true)
        && validProfile(request.resource.data, uid)
        && request.resource.data.uid == resource.data.uid
        && (!('email' in resource.data) || request.resource.data.email == resource.data.email)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if false;
    }

    // A subscrição é criada e actualizada apenas por código de servidor
    // com Firebase Admin SDK. O utilizador só pode ler o seu documento.
    match /subscriptions/{uid} {
      allow get: if ownsUser(uid);
      allow list, create, update, delete: if false;
    }

    // As tentativas/resultados são escritos e finalizados pelo servidor.
    // O cliente pode apenas ler tentativas pertencentes ao próprio utilizador.
    match /exam_attempts/{attemptId} {
      allow get, list: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Registos de pagamentos são confirmados por webhook/servidor.
    // O cliente só pode ler os seus próprios registos.
    match /payment_transactions/{transactionId} {
      allow get, list: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Negar tudo o que não esteja explicitamente autorizado acima.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
